# In Docker, the DB host is the mysql service name and the password must
# match docker/mysql/.env's MYSQL_ROOT_PASSWORD (connects as root — no
# separate per-service MySQL user is created).
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=career_agent_db

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Web-search-grounded questions (uses OpenAI's built-in web_search tool)
ENABLE_WEB_SEARCH_QUESTIONS=True
WEB_SEARCH_QUESTION_RATIO=0.3
WEB_SEARCH_MIN_QUESTIONS=10
WEB_SEARCH_MAX_QUESTIONS=15

# Optional certificate email delivery. Configure an SMTP provider before
# enabling users to send official PDF certificates by email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=certificates@example.com
SMTP_USE_TLS=True

# Security: set to True ONLY if running behind a trusted reverse proxy (Nginx, ALB)
TRUST_PROXY_HEADERS=False

# Strategy F Registry & Orchestrator Config. In Docker, ORCHESTRATOR_URL is
# reachable from this container as `orchestrator`, and AGENT_PUBLIC_URL is
# this agent's own address as seen *from* the orchestrator container, i.e.
# this service's own compose name (certificate-agent).
ORCHESTRATOR_URL=http://orchestrator:8100
AGENT_PUBLIC_URL=http://certificate-agent:8008/api/invoke
HEARTBEAT_INTERVAL_SECONDS=30
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret
