# --- Strategy F registration ---
ORCHESTRATOR_URL=http://orchestrator:8100
AGENT_PUBLIC_URL=http://job-agent:5020/api/invoke
HEARTBEAT_INTERVAL_SECONDS=30
# Must match the orchestrator's own AGENT_SHARED_SECRET — leave unset only
# for local dev, where both sides fall back to the same literal default.
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret

# --- This service's own database (never the shared platform DB) ---
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=job_agent
DB_POOL_SIZE=4


# --- Server ---
PORT=5020
JOBS_UPLOAD_DIR=/app/job_agent/uploads

# --- Scraper ---
JOBS_SCRAPER_USER_AGENT=DigiDARAJobsBot/1.0 (+https://digidara.com; jobs@digidara.com)
JOBS_SCRAPER_TIMEOUT_SECONDS=20
JOBS_SCRAPER_MAX_BYTES=5242880
JOBS_GREENHOUSE_MAX_RESPONSE_BYTES=15728640
JOBS_WORKER_POLL_SECONDS=15
# Requeue a run left in 'running' after a worker crash/restart (30 minutes).
JOBS_RUN_STALE_SECONDS=1800

# --- Daily Greenhouse automation ---
# The admin Sources toggle turns this on/off. Set this deployment's local
# execution time in 24-hour HH:MM format; Apify is always manual-only.
JOBS_AUTOMATION_TIME=09:00
JOBS_AUTOMATION_TIMEZONE=Asia/Kolkata
JOBS_AUTOMATION_DEFAULT_ENABLED=false
# Jobs are fetched only when posted within this many days, and removed this
# many days after posting (saved / applied jobs are kept).
JOBS_RETENTION_DAYS=7
# IT role x city searches run per day (the catalogue in providers.yaml rotates
# through them). Sized for the FREE plans over a 31-day month: Adzuna 70/day =
# 2,170 of 2,500; JSearch 6/day = 186 of 200. free_plan.py refuses any call
# past a free limit, so these can be lowered but should not be raised on a
# free plan.
JOBS_ADZUNA_DAILY_QUERIES=70
JOBS_JSEARCH_DAILY_QUERIES=6

# --- PR Labs Jobs API (prlabsapi.com) -- LinkedIn / Indeed jobs for the AI,
# data and web roles in providers.yaml (prlabs:), all of Tamil Nadu. Empty key
# = PR Labs collection is skipped. Each search is one API call; set the caps to
# the credits bought (free_plan.py refuses any call past them).
PRLABS_API_KEY=
JOBS_PRLABS_DAILY_QUERIES=14
JOBS_PRLABS_MONTHLY_CALLS=450

# --- Apify (optional — required only once LinkedIn/Naukri/Indeed/Glassdoor/
# Foundit actors are configured in providers/providers.yaml) ---
APIFY_API_TOKEN=

# --- SaaS ---
JOBS_FREE_TIER_FEED_LIMIT=20

# --- Conversation memory ---
# Server-owned recent turns included in the agent context (4-30).
JOB_MEMORY_RECENT_TURNS=12
# Automatic retention for inactive conversations (30-3650 days).
JOB_MEMORY_RETENTION_DAYS=365
# Maximum characters stored per user or assistant message (1000-50000).
JOB_MEMORY_MAX_MESSAGE_CHARS=12000

# --- Optional settings (documented from the code) ---
# Each line is commented out: the app uses the default shown. Uncomment only to override.
# If you change a default in code, record it in ENV-CHANGES.md: an uncommented key in the
# real .env keeps overriding the new default.
# Largest resume upload accepted (5 MB). Code default: 5242880
# JOBS_RESUME_MAX_BYTES=
# File the worker touches each poll; read by its Docker healthcheck. Code default: /tmp/job_worker_heartbeat
# JOBS_WORKER_HEARTBEAT_FILE=
# Heartbeat age at which the worker healthcheck fails. Code default: 4 x JOBS_WORKER_POLL_SECONDS + 60 (min 120)
# JOBS_WORKER_HEARTBEAT_STALE_SECONDS=

# Gateway request-signature check on incoming calls (uses AGENT_SHARED_SECRET). Code default: enforce
#   (warn only when AGENT_SHARED_SECRET is unset)
#   warn = log a missing/invalid signature but still serve it; enforce = reject with 401; off = skip.
#   Should be 0 in production: docker compose logs --since 24h <service> | grep -c gateway_signature_invalid
# AGENT_SIGNATURE_MODE=enforce
