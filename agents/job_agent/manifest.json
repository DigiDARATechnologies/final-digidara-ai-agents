{
  "agent_name": "job_agent",
  "version": "v1.0.0",
  "description": "Collects public job postings (Greenhouse, plus Apify-backed LinkedIn; Naukri/Indeed/Glassdoor/Foundit/Hirist/Instahyre/Internshala normalizers scaffolded but unverified against live actor output), scores them against a learner's profile with an explainable match score, and serves a save/apply-tracked job feed plus an admin moderation, source-health, and daily-automation surface.",
  "owner": "DigiDARA",
  "plan_tier": "free",
  "host": "127.0.0.1",
  "port": 5020,
  "path": "/api/invoke",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "health",
          "ensure_profile",
          "get_profile",
          "update_profile",
          "upload_resume",
          "chat",
          "get_categories",
          "get_feed",
          "get_saved_jobs",
          "get_hidden_jobs",
          "job_action",
          "get_applications",
          "export_user_data",
          "delete_user_data",
          "admin_list_users",
          "admin_update_plan",
          "admin_list_sources",
          "admin_get_automation",
          "admin_update_automation",
          "admin_create_source",
          "admin_update_source_status",
          "admin_run_source",
          "admin_list_runs",
          "admin_list_jobs",
          "admin_create_job",
          "admin_update_job_status",
          "admin_bulk_update_job_status",
          "admin_list_categories",
          "admin_greenhouse_companies",
          "admin_greenhouse_summary",
          "admin_greenhouse_pending_companies",
          "admin_greenhouse_revalidate",
          "admin_greenhouse_sync",
          "admin_greenhouse_run",
          "admin_apify_status",
          "admin_apify_actors",
          "admin_apify_run",
          "admin_adzuna_status",
          "admin_adzuna_run",
          "admin_jsearch_status",
          "admin_jsearch_run",
          "admin_tn_coverage"
        ]

      },
      "payload": { "type": "object" }
    },
    "required": ["action"]
  },
  "output_schema": { "type": "object" }
}
