# Copy to backend/.env and fill in real values for local development.

# Local SQLite development fallback (sqlite:///dev.db) works when running
# this agent directly on the host, but the rest of this platform runs on a
# shared MySQL instance with no SQLite anywhere else in the stack — in
# Docker, point this at the mysql service instead so this agent's data
# lives in the same place as everything else's. The password must match
# docker/mysql/.env's MYSQL_ROOT_PASSWORD (connects as root — no separate
# per-service MySQL user is created).
DATABASE_URL=mysql+pymysql://root:change-me@mysql:3306/resume_builder
AUTO_CREATE_TABLES=true

# Keep false for normal browser sessions. Only enable behind a trusted local gateway.
ALLOW_DEV_USER_HEADER=false

# Strategy F registry integration. AGENT_PUBLIC_URL must be reachable from
# the orchestrator; use a service DNS name rather than 127.0.0.1 in Docker.
STRATEGY_F_ENABLED=true
ORCHESTRATOR_URL=http://orchestrator:8100
AGENT_PUBLIC_URL=http://resume-builder-agent:5010/api/invoke
AGENT_NAME=resume_builder_agent
AGENT_VERSION=v1.0.0
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TTL_SECONDS=90
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret
FLASK_PORT=5010

# AI provider configuration. Use one of: openai, groq, or anthropic.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional alternative providers:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Generate your own random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-secret

# --- Optional settings (documented from the code) ---
# Each line is commented out: the app uses the default shown. Uncomment only to override.
# If you change a default in code, record it in ENV-CHANGES.md: an uncommented key in the
# real .env keeps overriding the new default.
# MySQL host. Code default: localhost
# DB_HOST=
# MySQL database. Code default: ai_resume_builder
# DB_NAME=
# MySQL password. Code default: (empty)
# DB_PASSWORD=
# MySQL port. Code default: 3306
# DB_PORT=
# MySQL user. Code default: root
# DB_USER=
# development enables dev-only behaviour; leave unset in production. Code default: unset
# FLASK_ENV=
# Bind address for `python run.py`. Code default: 0.0.0.0
# FLASK_HOST=
# Auto-reloader for local development only. Code default: false
# FLASK_RELOAD=
# Single allowed CORS origin. Code default: unset
# FRONTEND_ORIGIN=
# Comma-separated allowed CORS origins. Code default: unset
# FRONTEND_ORIGINS=
# Path to soffice for DOCX/PDF import. Code default: (auto-detect)
# LIBREOFFICE_BINARY=
# Shared rate-limit store; empty means per-process counters. Code default: (empty = in-memory)
# REDIS_URL=
