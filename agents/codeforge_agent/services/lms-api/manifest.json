{
  "agent_name": "codeforge_agent",
  "version": "v1.0.0",
  "description": "CodeForge coding-practice agent: course/technology/topic/problem browsing, Judge0-sandboxed code execution (Run = public tests, Submit = public+hidden tests), and a OpenAI-backed AI Tutor with a deterministic offline fallback.",
  "owner": "DigiDARA",
  "plan_tier": "free",
  "host": "127.0.0.1",
  "port": 4000,
  "path": "/api/invoke",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "health",
          "ensure_session",
          "dashboard",
          "list_courses",
          "list_technologies",
          "list_topics",
          "list_problems",
          "get_problem",
          "run_problem",
          "submit_problem",
          "tutor",
          "usage_summary"
        ]
      },
      "payload": { "type": "object" }
    },
    "required": ["action"]
  },
  "output_schema": { "type": "object" }
}
