# Local MySQL development configuration. Never commit real credentials.
# In Docker, MYSQL_HOST is the mysql service name, and MYSQL_PASSWORD must
# match docker/mysql/.env's MYSQL_ROOT_PASSWORD (this service connects as
# root — no separate per-service MySQL user is created).
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=leetcode
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=

# Shared with the Sites server environment, with different values per stage.
LMS_API_SHARED_SECRET=
CODING_PRACTICE_ENABLED=true
SIGNATURE_MAX_AGE_SECONDS=300
SESSION_DAYS=7

# Secure code execution service. The local service can read ignored judge0/judge0.conf;
# hosted environments must provide these through their secret manager.
# In Docker, `server` is Judge0's own compose service name for its API
# (agents/codeforge_agent/judge0/docker-compose.yml, included as-is).
JUDGE0_URL=http://server:2358
JUDGE0_AUTHN_HEADER=X-Auth-Token
JUDGE0_AUTHN_TOKEN=
JUDGE0_AUTHZ_HEADER=X-Auth-User
JUDGE0_AUTHZ_TOKEN=
JUDGE0_TIMEOUT_SECONDS=15

# Optional real AI Tutor. Without this key, safe deterministic guidance remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=12

# --- DigiDARA Strategy F registry integration ---
# In Docker, both must use service names, not 127.0.0.1: ORCHESTRATOR_URL is
# reachable from this container as `orchestrator`, and AGENT_PUBLIC_URL is
# this agent's own address as seen *from* the orchestrator container, i.e.
# this service's own compose name (codeforge-agent).
PORT=4000
ORCHESTRATOR_URL=http://orchestrator:8100
AGENT_PUBLIC_URL=http://codeforge-agent:4000/api/invoke
HEARTBEAT_INTERVAL_SECONDS=30
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret

# Gateway request-signature check on incoming calls (uses AGENT_SHARED_SECRET). Code default: warn
#   warn = log a missing/invalid signature but still serve it; enforce = reject with 401; off = skip.
#   Check readiness before enforcing: docker compose logs --since 24h <service> | grep -c gateway_signature_invalid
# AGENT_SIGNATURE_MODE=warn
