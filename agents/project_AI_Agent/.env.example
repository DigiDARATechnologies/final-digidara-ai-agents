LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# In Docker, the DB host is the mysql service name and the password must
# match docker/mysql/.env's MYSQL_ROOT_PASSWORD (connects as root — no
# separate per-service MySQL user is created). ORCHESTRATOR_URL and
# AGENT_PUBLIC_URL (this agent's own address, as seen *from* the
# orchestrator container) must use Docker service names too.
DATABASE_URL=mysql+pymysql://root:change-me@mysql:3306/capstone_agent
UPLOAD_DIR=./uploads
ORCHESTRATOR_URL=http://orchestrator:8100
AGENT_PUBLIC_URL=http://capstone-agent:8000/api/invoke
HEARTBEAT_INTERVAL_SECONDS=30
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret

# CodeExecutionNode — supplementary sandboxed "does it run" evidence for a
# submission's Python entry point (see app/execution/judge0_client.py).
# Shares the same Judge0 instance agents/codeforge_agent already uses; if
# it's not running, execution evidence is simply marked unavailable and
# grading proceeds on OCR/static review alone, same as before this existed.
# In Docker, `server` is Judge0's own compose service name for its API
# (agents/codeforge_agent/judge0/docker-compose.yml, included as-is).
JUDGE0_URL=http://server:2358
CODE_EXECUTION_CPU_SECONDS=5
CODE_EXECUTION_WALL_SECONDS=10
CODE_EXECUTION_MEMORY_KB=128000

# topic_generator_node web search (free-topic/"interview based" requests
# only — see app/config.py). Requires OPENAI_API_KEY regardless of LLM_MODEL.
ENABLE_TOPIC_WEB_SEARCH=true
WEB_SEARCH_LLM_MODEL=gpt-5-search-api
WEB_SEARCH_CONTEXT_SIZE=low

# --- Optional settings (documented from the code) ---
# Each line is commented out: the app uses the default shown. Uncomment only to override.
# If you change a default in code, record it in ENV-CHANGES.md: an uncommented key in the
# real .env keeps overriding the new default.
# Comma-separated CORS origins. Code default: http://localhost:5173
# ALLOWED_ORIGINS=
# dev or production. Code default: dev
# ENV=
# Log level. Code default: DEBUG
# LOG_LEVEL=
# Timeout for the headless-browser check of a submission. Code default: 10000
# BROWSER_CHECK_TIMEOUT_MS=
# Largest submission upload. Code default: 50
# MAX_UPLOAD_MB=
# Most files allowed inside a submitted zip. Code default: 1000
# MAX_ZIP_FILES=
# Characters of the student's source code the reviewers read (all files in full
# while the zip fits; the largest are trimmed past this). Code default: 160000
# CODE_REVIEW_CHAR_BUDGET=
# Score needed to pass a submission. Code default: 70
# PASS_THRESHOLD=
# Days a learner has to submit after choosing a topic. Code default: 7
# SUBMISSION_WINDOW_DAYS=

# Gateway request-signature check on incoming calls (uses AGENT_SHARED_SECRET). Code default: warn
#   warn = log a missing/invalid signature but still serve it; enforce = reject with 401; off = skip.
#   Check readiness before enforcing: docker compose logs --since 24h <service> | grep -c gateway_signature_invalid
# AGENT_SIGNATURE_MODE=warn
