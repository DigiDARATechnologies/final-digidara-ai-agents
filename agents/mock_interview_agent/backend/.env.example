OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EVAL_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SEARCH_MODEL=gpt-5.5
ENABLE_LIVE_WEB_SEARCH=false
WEB_SEARCH_TIMEOUT_SECONDS=45
WEB_SEARCH_MAX_OUTPUT_TOKENS=8192
OPENAI_REQUEST_TIMEOUT_SECONDS=20
OPENAI_QUESTION_TIMEOUT_SECONDS=10

# In Docker, the DB host is the mysql service name and the password must
# match docker/mysql/.env's MYSQL_ROOT_PASSWORD (connects as root — no
# separate per-service MySQL user is created).
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mock_interview_db
DB_POOL_SIZE=4

DAILY_LIMIT_ENABLED=false
DAILY_QUOTA_TIMEZONE_OFFSET_MINUTES=330

FLASK_DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173
MAX_AUDIO_UPLOAD_MB=10
MAX_AVATAR_UPLOAD_MB=3

# Session tokens minted by routes/invoke.py's ensure_session (see
# session_auth.py) -- this module has no login system of its own.
SESSION_JWT_SECRET=change-me
SESSION_JWT_TTL_SECONDS=43200

# Strategy F registry integration (backend/integration/registry_client.py).
# AGENT_PUBLIC_URL is this agent's own address, as seen *from* the
# orchestrator container.
ORCHESTRATOR_URL=http://orchestrator:8100
AGENT_PUBLIC_URL=http://mock-interview-agent:5030/api/invoke
HEARTBEAT_INTERVAL_SECONDS=30
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret
