# Flask
FLASK_ENV=development
SECRET_KEY=dev-only-secret
JWT_SECRET_KEY=dev-only-jwt-secret
PORT=5001

# MySQL. In Docker, the host is the mysql service name and the password
# must match docker/mysql/.env's MYSQL_ROOT_PASSWORD (connects as root —
# no separate per-service MySQL user is created).
DATABASE_URL=mysql+pymysql://root:change-me@mysql:3306/communication_module

# LLM provider (see AI_PROVIDER: "auto" picks OpenAI if OPENAI_API_KEY is set,
# else falls back to Groq)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# CORS — the shared DigiDARA UI's dev origin
FRONTEND_ORIGIN=http://localhost:5173

# Strategy F (agents/communication-ai-agent/INTEGRATION.md)
ORCHESTRATOR_URL=http://orchestrator:8100
# Must be reachable *from* the orchestrator process — never 127.0.0.1 across
# separate containers/hosts. Defaults to manifest.json's host:port when unset.
# In Docker this is this service's own compose name (communication-agent).
AGENT_PUBLIC_URL=http://communication-agent:5001/api/invoke
HEARTBEAT_INTERVAL_SECONDS=30
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret

# --- Optional settings (documented from the code) ---
# Each line is commented out: the app uses the default shown. Uncomment only to override.
# If you change a default in code, record it in ENV-CHANGES.md: an uncommented key in the
# real .env keeps overriding the new default.
# Per-learner answer submission rate limit. Code default: 12 per minute
# ANSWER_RATE_LIMIT=
# Currency label for logged Groq cost estimates. Code default: USD
# GROQ_COST_CURRENCY=
# Groq input price per 1M tokens, for cost logging. Code default: unset
# GROQ_INPUT_COST_PER_1M=
# Alias read as a fallback for GROQ_INPUT_COST_PER_1M. Code default: unset
# GROQ_INPUT_PRICE_PER_1M=
# Groq output price per 1M tokens, for cost logging. Code default: unset
# GROQ_OUTPUT_COST_PER_1M=
# Alias read as a fallback for GROQ_OUTPUT_COST_PER_1M. Code default: unset
# GROQ_OUTPUT_PRICE_PER_1M=
# Alias for GROQ_COST_CURRENCY. Code default: USD
# GROQ_PRICE_CURRENCY=
# Date the configured Groq prices were taken from. Code default: unset
# GROQ_PRICING_EFFECTIVE_DATE=
# Where the configured Groq prices came from. Code default: https://console.groq.com/docs/models
# GROQ_PRICING_SOURCE=
# Log per-call Groq token usage. Code default: true
# GROQ_USAGE_LOGGING=
# Where profile pictures are stored. Code default: <backend>/uploads
# PROFILE_UPLOAD_FOLDER=
# Rate-limit store; memory:// is per-process, use redis:// to share across workers. Code default: memory://
# RATELIMIT_STORAGE_URI=
