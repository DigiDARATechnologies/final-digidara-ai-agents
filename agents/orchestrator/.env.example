# Docker-network service configuration. Copy to .env and replace secrets.
ENV=dev
DATABASE_URL=mysql+pymysql://root:change-me@mysql:3306/digidara_registry
JWT_SECRET=replace-with-a-long-random-jwt-secret
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_AGENT_HOSTS=capstone-agent,codeforge-agent,communication-agent,aptitude-agent,resume-builder-agent,certificate-agent,job-agent,mock-interview-agent,127.0.0.1,localhost
AGENT_CALL_TIMEOUT_SECONDS=120

# Optional operator account bootstrap. Remove after the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional integrations.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TOKEN_COST_PER_CALL=100

# PDF invoices (app/billing/invoice.py). All optional: without them the invoice
# is a plain receipt from "DigiDARA" with no tax lines. Fill these in with your
# real legal details before relying on the invoices for tax purposes.
INVOICE_COMPANY_NAME=
# Address lines separated by "|", e.g. 12 Example Street|Chennai, Tamil Nadu 600001
INVOICE_COMPANY_ADDRESS=
INVOICE_GSTIN=
# GST rate (percent) included in every price, e.g. 18. Leave empty to show no tax breakup.
INVOICE_GST_RATE=

# --- Optional settings (documented from the code) ---
# Each line is commented out: the app uses the default shown. Uncomment only to override.
# If you change a default in code, record it in ENV-CHANGES.md: an uncommented key in the
# real .env keeps overriding the new default.
# Chat requests per user per minute. Code default: 20
# CHAT_RATE_LIMIT_PER_MIN=
# Login token lifetime in minutes (7 days). Code default: 10080
# JWT_EXPIRES_MINUTES=
# Log level. Code default: INFO
# LOG_LEVEL=
# Max age of a signed agent registration request (replay window). Code default: 300
# SIGNATURE_MAX_AGE_SECONDS=
# Gateway timeout for Aptitude create_test (must exceed the agent's generation deadline). Code default: 210
# APTITUDE_CREATE_TEST_TIMEOUT_SECONDS=
# How often agents are expected to heartbeat. Code default: 30
# HEARTBEAT_INTERVAL_SECONDS=
# Age after which an agent with no heartbeat is treated as down. Code default: 90
# HEARTBEAT_TTL_SECONDS=
