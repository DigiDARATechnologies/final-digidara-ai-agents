# Docker-network service configuration. Copy to .env and replace secrets.
ENV=dev
DATABASE_URL=mysql+pymysql://root:change-me@mysql:3306/digidara_registry
JWT_SECRET=replace-with-a-long-random-jwt-secret
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_AGENT_HOSTS=capstone-agent,codeforge-agent,communication-agent,aptitude-agent,resume-builder-agent,certificate-agent,job-agent,mock-interview-agent,127.0.0.1,localhost
AGENT_CALL_TIMEOUT_SECONDS=120
MOCK_INTERVIEW_GENERATION_TIMEOUT_SECONDS=180

# Optional operator account bootstrap. Remove after the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional integrations.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TOKEN_COST_PER_CALL=100

# PDF invoices (app/billing/invoice.py), headed by the DigiDARA AI Agents logo.
# A plan paid at its price + 18% GST is always printed as a TAX INVOICE split
# into price and GST, with the buyer's GSTIN when they gave one at checkout.
# Fill these in with your real legal details (your GSTIN is printed under the
# company name) before relying on the invoices for tax purposes.
INVOICE_COMPANY_NAME=
# Address lines separated by "|", e.g. 12 Example Street|Chennai, Tamil Nadu 600001
INVOICE_COMPANY_ADDRESS=
INVOICE_GSTIN=
# Only for payments that are not a plan price + GST (e.g. old ones): GST rate
# (percent) included in the amount, e.g. 18. Leave empty to show no tax breakup.
INVOICE_GST_RATE=

# --- Optional settings (documented from the code) ---
# Each line is commented out: the app uses the default shown. Uncomment only to override.
# If you change a default in code, record it in ENV-CHANGES.md: an uncommented key in the
# real .env keeps overriding the new default.
# Chat requests per user per minute. Code default: 20
# CHAT_RATE_LIMIT_PER_MIN=
# Login token lifetime in minutes (7 days). Code default: 10080
# JWT_EXPIRES_MINUTES=
# Log level. Code default: INFO
# LOG_LEVEL=
# Max age of a signed agent registration request (replay window). Code default: 300
# SIGNATURE_MAX_AGE_SECONDS=
# Gateway timeout for Aptitude create_test (must exceed the agent's generation deadline). Code default: 210
# APTITUDE_CREATE_TEST_TIMEOUT_SECONDS=
# How often agents are expected to heartbeat. Code default: 30
# HEARTBEAT_INTERVAL_SECONDS=
# Age after which an agent with no heartbeat is treated as down. Code default: 90
# HEARTBEAT_TTL_SECONDS=
# Points a brand-new (free) account starts with: 25 points = 50,000 tokens. Code default: 25
# FREE_SIGNUP_POINTS=
# Tokens per point for new free accounts (every plan sells at this rate). Code default: 2000
# FREE_TOKENS_PER_POINT=
# What each plan charges in paise (price + 18% GST). Code defaults: 47082 (399), 94282 (799), 117882 (999).
# Plans are paid in the in-app Razorpay checkout, which shows the account's own
# email locked. Set a *_PAGE_URL ONLY to sell that plan on a hosted Razorpay
# payment page instead -- a page cannot lock the email, so its points go to
# whatever account matches the email typed there. Leave them unset.
# RAZORPAY_BASIC_PAGE_URL=
# RAZORPAY_BASIC_PAGE_AMOUNT=
# RAZORPAY_STANDARD_PAGE_URL=
# RAZORPAY_STANDARD_PAGE_AMOUNT=
# RAZORPAY_PREMIUM_PAGE_URL=
# RAZORPAY_PREMIUM_PAGE_AMOUNT=
# OpenAI model for the general chat's microphone (uses OPENAI_API_KEY). Code default: gpt-4o-mini-transcribe
# OPENAI_TRANSCRIPTION_MODEL=
# Email verification codes for password sign-ups (Gmail: smtp.gmail.com, port 587, an App Password).
# Verification is enforced only when SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all set
# (override with EMAIL_VERIFICATION_REQUIRED=true|false). Never commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# EMAIL_VERIFICATION_REQUIRED=auto
# Where rate-limit counters live. docker-compose.yml sets redis://ratelimit-redis:6379/0 so all workers share them.
# Code default: memory:// (per worker process)
# RATE_LIMIT_STORAGE_URI=
# Phase 2 A2A hub: the public origin used in agent-card URLs
# (e.g. https://staging.digidaraaiagents.com). Code default: derived from the
# request's Host header, https outside localhost.
# A2A_PUBLIC_BASE_URL=
