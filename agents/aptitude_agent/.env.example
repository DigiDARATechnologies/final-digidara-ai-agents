APP_ENV=development
DEBUG=true
# In Docker, the DB host is the mysql service name and the password must
# match docker/mysql/.env's MYSQL_ROOT_PASSWORD (connects as root — no
# separate per-service MySQL user is created).
DATABASE_URL=mysql+pymysql://root:change-me@mysql:3306/aptitude_ai
SECRET_KEY=change-me
JWT_SECRET=change-me

# Strategy F registry integration (backend/app/integration/registry_client.py).
# This file previously didn't declare these at all, so the agent silently
# fell back to the code default of http://127.0.0.1:8100 — that default
# doesn't resolve in Docker, so it's made explicit here. AGENT_PUBLIC_URL is
# this agent's own address, as seen *from* the orchestrator container.
ORCHESTRATOR_URL=http://orchestrator:8100
AGENT_PUBLIC_URL=http://aptitude-agent:5000/api/invoke
HEARTBEAT_INTERVAL_SECONDS=30
AGENT_SHARED_SECRET=replace-with-the-same-long-random-agent-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=
OPENAI_TIMEOUT_SECONDS=12
OPENAI_BACKGROUND_TIMEOUT_SECONDS=20
OPENAI_BATCH_TIMEOUT_SECONDS=120
BATCH_GENERATION_DEADLINE_SECONDS=180
BATCH_GENERATION_MAX_ATTEMPTS=3
OPENAI_JSON_MAX_COMPLETION_TOKENS=2048
QUESTION_GENERATION_MAX_COMPLETION_TOKENS=16000
HINT_CACHE_TTL_SECONDS=120
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60

# --- Optional settings (documented from the code) ---
# Each line is commented out: the app uses the default shown. Uncomment only to override.
# If you change a default in code, record it in ENV-CHANGES.md: an uncommented key in the
# real .env keeps overriding the new default.
# Idle seconds before an in-progress test is marked abandoned. Code default: 180
# ABANDON_AFTER_SECONDS=
# Fall back to built-in demo questions when generation fails. MUST be false in production. Code default: true
# ALLOW_DEMO_QUESTIONS=
# Minutes east of UTC used for day boundaries (330 = IST). Code default: 330
# APP_TIMEZONE_OFFSET_MINUTES=
# Lifetime of an issued session token. Code default: 43200
# AUTH_TOKEN_TTL_SECONDS=
# Minimum gap between background question-bank OpenAI calls. Code default: 2
# BANK_OPENAI_CALL_INTERVAL_SECONDS=
# Extra DB connections allowed beyond DB_POOL_SIZE (x4 gunicorn workers; keep total under MySQL max_connections). Code default: 20
# DB_MAX_OVERFLOW=
# DB connections per gunicorn worker. Code default: 10
# DB_POOL_SIZE=
# Allowed CORS origin. Code default: http://localhost:5173
# FRONTEND_ORIGIN=
# Hints a learner may use per test. Code default: 3
# HINTS_PER_TEST=
# Token cap for a hint (clamped 64-128). Code default: 96
# HINT_MAX_COMPLETION_TOKENS=
# Timeout for one hint request. Code default: 5
# HINT_TIMEOUT_SECONDS=
# Bind address for `python app.py` (gunicorn ignores it). Code default: 127.0.0.1
# HOST=
# Session token signing algorithm. Code default: HS256
# JWT_ALGORITHM=
# Session token audience claim. Code default: aptitude-ai
# JWT_AUDIENCE=
# Session token issuer claim. Code default: aptidara
# JWT_ISSUER=
# Single-user (dev) mode: learner email. Code default: kiruthika@example.edu
# LOCAL_USER_EMAIL=
# Single-user (dev) mode: learner id. Code default: demo-student-001
# LOCAL_USER_ID=
# Single-user (dev) mode: learner name. Code default: Kiruthika
# LOCAL_USER_NAME=
# Retries for a background job before it is marked failed. Code default: 3
# MAX_JOB_ATTEMPTS=
# How long the OpenAI circuit breaker stays open. Code default: 90
# OPENAI_CIRCUIT_COOLDOWN_SECONDS=
# Consecutive OpenAI failures that open the circuit breaker. Code default: 5
# OPENAI_CIRCUIT_FAILURE_THRESHOLD=
# Port for `python app.py` (gunicorn ignores it). Code default: 5000
# PORT=
# Seconds per question (base value). Code default: 60
# QUESTION_SECONDS=
# Seconds per Easy question (defaults to QUESTION_SECONDS). Code default: 60
# QUESTION_SECONDS_EASY=
# Seconds per Medium question. Code default: 90
# QUESTION_SECONDS_MEDIUM=
# Seconds per Hard question. Code default: 120
# QUESTION_SECONDS_HARD=
# Recent questions per learner excluded from new tests. Code default: 30
# RECENT_QUESTION_HISTORY_LIMIT=
# Timeout for the recommendation call (clamped 1-8). Code default: 7
# RECOMMENDATION_TIMEOUT_SECONDS=
# Skip login and use LOCAL_USER_*. MUST be false in production. Code default: true
# SINGLE_USER_MODE=
# Tests a learner may start per window. Code default: 100 in development, 10 otherwise
# START_TEST_RATE_LIMIT=
# Window for START_TEST_RATE_LIMIT. Code default: 3600
# START_TEST_RATE_WINDOW_SECONDS=
# Grace after a question timer before it counts as timed out. Code default: 3
# TIMEOUT_GRACE_SECONDS=
# Background worker heartbeat interval. Code default: 10
# WORKER_HEARTBEAT_SECONDS=
# Background worker poll interval. Code default: 2
# WORKER_POLL_SECONDS=
# Age after which a worker heartbeat is considered stale. Code default: 45
# WORKER_STALE_SECONDS=

# Gateway request-signature check on incoming calls (uses AGENT_SHARED_SECRET). Code default: warn
#   warn = log a missing/invalid signature but still serve it; enforce = reject with 401; off = skip.
#   Check readiness before enforcing: docker compose logs --since 24h <service> | grep -c gateway_signature_invalid
# AGENT_SIGNATURE_MODE=warn
