APP_ENV=development
DEBUG=true
# In Docker, the DB host is the mysql service name and the password must
# match docker/mysql/.env's MYSQL_ROOT_PASSWORD (connects as root — no
# separate per-service MySQL user is created).
DATABASE_URL=mysql+pymysql://root:change-me@mysql:3306/aptitude_ai
SECRET_KEY=change-me
JWT_SECRET=change-me

# Strategy F registry integration (backend/app/integration/registry_client.py).
# This file previously didn't declare these at all, so the agent silently
# fell back to the code default of http://127.0.0.1:8100 — that default
# doesn't resolve in Docker, so it's made explicit here. AGENT_PUBLIC_URL is
# this agent's own address, as seen *from* the orchestrator container.
ORCHESTRATOR_URL=http://orchestrator:8100
AGENT_PUBLIC_URL=http://aptitude-agent:5000/api/invoke
HEARTBEAT_INTERVAL_SECONDS=30
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=
OPENAI_TIMEOUT_SECONDS=12
OPENAI_BACKGROUND_TIMEOUT_SECONDS=20
LIVE_QUESTION_DEADLINE_SECONDS=30
OPENAI_JSON_MAX_COMPLETION_TOKENS=2048
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60
