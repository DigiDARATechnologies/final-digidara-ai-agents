VITE_GATEWAY_API_URL=http://127.0.0.1:8100
VITE_CAPSTONE_AGENT_NAME=capstone_project_agent
VITE_CODEFORGE_AGENT_NAME=codeforge_agent
VITE_APTITUDE_AGENT_NAME=aptitude_agent
VITE_COMMUNICATION_AGENT_NAME=communication_agent
VITE_RESUME_BUILDER_AGENT_NAME=resume_builder_agent
VITE_CERTIFICATE_AGENT_AGENT_NAME=certificate_agent
VITE_JOB_AGENT_NAME=job_agent
# Public OAuth client ID from Google Cloud Console (safe to expose
# client-side) — the matching client secret lives only in the orchestrator's
# own .env as GOOGLE_CLIENT_SECRET.
VITE_GOOGLE_CLIENT_ID=

# Server-only Razorpay credentials (never prefix the secret with VITE_)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
