# DigiDARA React/Vite frontend, built and served by nginx.
FROM node:20-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Built as a relative-path SPA: nginx (see nginx.conf) reverse-proxies
# /auth, /chat, /gateway, /billing, /registry to the orchestrator container,
# so the browser never needs the orchestrator's own address. Leaving this
# empty is what makes that possible — orchestrator's port stays
# internal-only and is never published to the host. VITE_GOOGLE_CLIENT_ID is
# a public OAuth client ID (safe to expose client-side) passed through from
# the host's .env via docker-compose build args.
ARG VITE_GATEWAY_API_URL=""
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_GATEWAY_API_URL=$VITE_GATEWAY_API_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80/ || exit 1
