{
  "name": "digidara-agents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:agents": "python scripts/test_agents.py",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --coverage",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-jest": "^30.5.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
