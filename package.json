{
  "name": "digidara-agents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:production-camera-guard": "npm run build && node scripts/verify-production-camera-guard.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:agents": "python scripts/test_agents.py",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --coverage",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "html2canvas-pro": "1.6.7",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-jest": "^30.5.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.2",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  }
}
